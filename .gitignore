# Build output
/caravana
/bin/
/dist/
*.exe

# Go test and profiling output
*.test
*.out
*.prof
coverage.html

# Local Go workspace (single-module repo; don't share workspace overrides)
go.work
go.work.sum

# Local data: SQLite databases the control plane creates while developing
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets and certificates (Traefik ACME state, mkcert certs, env files)
.env
.env.*
!.env.example
acme.json
*.pem
*.key

# Local Nomad lab state (if a data dir is ever pointed inside the repo)
/deploy/dev/.data/
/deploy/vm/host.env

# Claude Code: personal settings stay local; shared .claude/ files are committed
.claude/settings.local.json

# Serena (personal coding-agent tool): per-developer config and cache
.serena/

# Spec Kit helper scripts
__pycache__/

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# Claude Design handoff: local reference only (its sample data has real names and domains)
/design/

# The style tool's download cache (tools/ui-css.sh)
/.cache/

/.private/
.headroom*

# Example apps: the overlay holds secret values
/deploy/examples/*/overlay.json

# The impeccable design skill: its launcher downloads its binary on first run, and its critique
# notes are per-session. Claude Code uses .claude/skills; no Copilot copies under .github/.
/.claude/skills/impeccable/scripts/bin/
/.impeccable/critique/

# Claude Code worktrees (local)
/.claude/worktrees/

.bella
