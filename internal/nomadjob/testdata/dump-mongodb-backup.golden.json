            "args": [
              "set -eu\numask 077\nnl='\n'\nfor v in \"$DB_HOST\" \"$DB_PORT\" \"$DB_USER\" \"$DB_PASSWORD\"; do\n  case \"$v\" in\n    *\"$nl\"*) echo \"a value the backup logs in with has a line break\" \u003e\u00262; exit 1 ;;\n  esac\ndone\nesc() { printf '%s' \"$1\" | sed 's/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g'; }\ncommand -v mongodump \u003e/dev/null 2\u003e\u00261 || { echo \"the image has no mongodump\" \u003e\u00262; exit 1; }\ncfg=\"$NOMAD_SECRETS_DIR/mongo.yaml\"\nprintf 'password: \"%s\"\\n' \"$(esc \"$DB_PASSWORD\")\" \u003e \"$cfg\"\nmongodump --config=\"$cfg\" --host=\"$DB_HOST\" --port=\"$DB_PORT\" --username=\"$DB_USER\" --authenticationDatabase=admin --archive=/alloc/data/backup.dump --gzip\n"
            ],
            "entrypoint": [
              "/bin/sh",
              "-c"
            ],
            "image": "mongo@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
          },
