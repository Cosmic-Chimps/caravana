{
  "Job": {
    "ID": "whoami",
    "Name": "whoami",
    "Type": "service",
    "Datacenters": ["*"],
    "Meta": {
      "caravana.app": "whoami",
      "caravana.deployment": "lab-manual"
    },
    "Update": {
      "MaxParallel": 1,
      "HealthCheck": "checks",
      "MinHealthyTime": 10000000000,
      "HealthyDeadline": 180000000000,
      "ProgressDeadline": 600000000000,
      "AutoRevert": true,
      "AutoPromote": true
    },
    "TaskGroups": [
      {
        "Name": "web",
        "Count": 2,
        "Update": { "Canary": 2 },
        "Spreads": [{ "Attribute": "${node.unique.id}", "Weight": 100 }],
        "ShutdownDelay": 5000000000,
        "Disconnect": {
          "LostAfter": 300000000000,
          "Replace": true,
          "Reconcile": "keep_original"
        },
        "Networks": [
          {
            "Mode": "bridge",
            "DynamicPorts": [{ "Label": "http", "To": 80 }]
          }
        ],
        "Services": [
          {
            "Name": "whoami-web",
            "PortLabel": "http",
            "Provider": "nomad",
            "Tags": [
              "traefik.enable=true",
              "traefik.http.routers.whoami-web.rule=Host(`whoami.localhost`)",
              "traefik.http.routers.whoami-web.entrypoints=websecure",
              "traefik.http.routers.whoami-web.tls=true",
              "traefik.http.routers.whoami-web.middlewares=whoami-web-retry",
              "traefik.http.middlewares.whoami-web-retry.retry.attempts=3",
              "traefik.http.services.whoami-web.loadbalancer.healthcheck.path=/",
              "traefik.http.services.whoami-web.loadbalancer.healthcheck.interval=10s",
              "traefik.http.services.whoami-web.loadbalancer.healthcheck.timeout=2s"
            ],
            "CanaryTags": ["caravana.canary=true"],
            "Checks": [
              {
                "Name": "health",
                "Type": "http",
                "Path": "/",
                "Interval": 10000000000,
                "Timeout": 2000000000
              }
            ]
          },
          {
            "Name": "whoami-web-internal",
            "PortLabel": "http",
            "Provider": "nomad",
            "AddressMode": "alloc",
            "Tags": ["caravana-place=default/production", "caravana-name=whoami-web", "caravana-name=whoami"],
            "CanaryTags": ["caravana-place=default/production", "caravana-name=whoami-web", "caravana-name=whoami", "caravana.canary=true"]
          }
        ],
        "Tasks": [
          {
            "Name": "web",
            "Driver": "docker",
            "Config": {
              "image": "traefik/whoami@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44"
            },
            "Resources": { "CPU": 100, "MemoryMB": 64, "MemoryMaxMB": 256 }
          },
          {
            "Name": "names",
            "Driver": "docker",
            "Lifecycle": { "Hook": "prestart", "Sidecar": true },
            "Config": {
              "image": "busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e",
              "command": "/bin/sh",
              "args": ["-c", "[ -f /local/base ] || cp /etc/hosts /local/base\ncat /local/base /local/names > /etc/hosts\ntrap 'exit 0' TERM INT\nwhile :; do sleep 3600 & wait $!; done\n"]
            },
            "Resources": { "CPU": 20, "MemoryMB": 16 },
            "KillTimeout": 1000000000,
            "Templates": [
              {
                "DestPath": "local/names",
                "EmbeddedTmpl": "{{ range nomadService \"whoami-web-internal\" }}{{ if not (.Tags | contains \"caravana.canary=true\") }}{{ .Address }} web\n{{ end }}{{ end }}{{ range nomadServices }}{{ if .Tags | contains \"caravana-place=default/production\" }}{{ $svc := .Name }}{{ range .Tags }}{{ if regexMatch \"^caravana-name=\" . }}{{ $n := regexReplaceAll \"^caravana-name=\" \"\" . }}{{ $k := printf \"n:%s\" $n }}{{ if scratch.Key $k }}{{ scratch.Set $k \"\" }}{{ else }}{{ scratch.Set $k $svc }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}{{ range nomadServices }}{{ if .Tags | contains \"caravana-place=default/production\" }}{{ $svc := .Name }}{{ range .Tags }}{{ if regexMatch \"^caravana-name=\" . }}{{ $n := regexReplaceAll \"^caravana-name=\" \"\" . }}{{ if and (eq (scratch.Get (printf \"n:%s\" $n)) $svc) (ne $n \"web\") }}{{ range nomadService $svc }}{{ if not (.Tags | contains \"caravana.canary=true\") }}{{ .Address }} {{ $n }}\n{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}",
                "ChangeMode": "script",
                "ChangeScript": {
                  "Command": "/bin/sh",
                  "Args": ["-c", "cat /local/base /local/names > /etc/hosts"],
                  "Timeout": 5000000000,
                  "FailOnError": false
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
