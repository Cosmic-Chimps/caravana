# Settings for deploy/vm/host.sh. Copy to deploy/vm/host.env (gitignored) and fill in.
# No secrets go here: tokens stay on the host and are read over SSH when needed.

# SSH target of the VM: root, or a user with passwordless sudo, with key login.
CARAVANA_HOST=root@203.0.113.10

# The app the gate proof deploys (whoami). Its DNS record must point at the VM.
CARAVANA_DOMAIN_APP=whoami.example.com

# The public webhook host: only /v1/webhooks/* is routed there. Its DNS record must point at the VM.
CARAVANA_DOMAIN_WEBHOOK=hooks.example.com

# Let's Encrypt account email (expiry notices go here).
CARAVANA_ACME_EMAIL=ops@example.com

# 1 = Let's Encrypt's staging CA (no rate limits, untrusted certificates) while iterating;
# 0 = production, needed to prove the gate.
CARAVANA_ACME_STAGING=1
