  ],
  "intent": "Scheduled Postgres backups to S3-compatible storage, listed in Caravana, restorable into the running database",
  "decisions": [
    {
      "decision": "Periodic batch job <app>_<service>_backup: pg_dump prestart + rclone upload with retention",
      "why": "lab-proven; Nomad schedules periodic work only as its own job type",
      "rejected": "dumps from the control plane; cron in the DB container"
    },
    {
      "decision": "Runs recorded in SQLite by a watcher from Nomad periodic children",
      "why": "no S3 client or network path from Caravana to the bucket",
      "rejected": "listing the bucket with an S3 client"
    },
    {
      "decision": "Credentials in the job own Nomad Variable, written by Caravana",
      "why": "a job can only read its own path; reading another hangs",
      "rejected": "one shared variable"
    },
    {
      "decision": "Postgres only",
      "why": "gate database; dump/restore over the network",
      "rejected": "MySQL and Redis in the same feature"
    }
  ],
  "step_summaries": {
    "plan": {
      "summary": "Backups as periodic batch jobs with rclone, runs recorded by a watcher, restore as a batch job",
      "key_finding": "Restart/reschedule attempts must be 0 or a failed dump blocks the schedule; same-second forces collide"
    }
  },
