  "intent": "Deploy a Docker Compose file as a Caravana app: loud errors, warnings for changed meaning, services by name, named volumes as host volumes",
  "decisions": [
    {
      "decision": "compose-go v2 with WithSupportedAttributes allowlist",
      "why": "official parser; fails closed with attribute paths",
      "rejected": "hand-written YAML decoding"
    },
    {
      "decision": "Names sidecar per group rewriting /etc/hosts from alloc-mode registrations",
      "why": "only lab-proven way to resolve service names across redeploys without Consul",
      "rejected": "extra_hosts (stale after first redeploy), env-only discovery"
    },
    {
      "decision": "Named volumes as Nomad dynamic host volumes <app>_<volume>, created by deploy before Register",
      "why": "no client restarts; lab-proven persistence",
      "rejected": "static host_volume blocks"
    },
    {
      "decision": "Groups with a volume: canary 0, one copy",
      "why": "single-writer volume cannot hold a canary",
      "rejected": "multi-writer volumes"
    },
    {
      "decision": "JSON overlay next to the file; two operations deployCompose and previewCompose",
      "why": "file stays portable; generated clients",
      "rejected": "x-caravana extension; oneOf on deployApp"
    }
  ],
